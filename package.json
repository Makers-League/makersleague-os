{
  "name": "makersleague-os",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:start && turbo run dev",
    "build": "turbo run build",
    "check": "oxfmt && turbo run lint:oxlint typecheck test",
    "lint": "turbo run lint:oxlint --output-logs=errors-only",
    "lint:oxlint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "bash scripts/db-reseed.sh && supabase test db",
    "test:e2e": "pnpm --filter @ml/web test:e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,storage-api,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "bash scripts/db-reseed.sh --full",
    "db:reseed": "bash scripts/db-reseed.sh",
    "db:migrate:new": "supabase migration new",
    "db:types": "supabase gen types typescript --schema public > packages/db/src/database.types.ts && oxfmt packages/db/src/database.types.ts",
    "sync": "pnpm --filter @ml/easyverein sync",
    "env:local": "bash scripts/local-env.sh"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "supabase": "3.2.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "sharp",
      "esbuild"
    ]
  }
}
