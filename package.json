{
  "name": "makersleague-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run db:start && turbo run dev",
    "build": "turbo run build",
    "check": "bun fmt && turbo run lint typecheck test",
    "lint": "bun lint --no-script --type-aware",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "bash scripts/db-reseed.sh && supabase test db",
    "test:integration": "bun run --cwd packages/easyverein test:integration",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "supabase stop",
    "db:reset": "bash scripts/db-reseed.sh --full",
    "db:reseed": "bash scripts/db-reseed.sh",
    "db:migrate:new": "supabase migration new",
    "db:types": "supabase gen types typescript --schema public > packages/db/src/database.types.ts && bun fmt packages/db/src/database.types.ts",
    "sync": "bun run --cwd packages/easyverein sync",
    "env:local": "bash scripts/local-env.sh"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "bun": "1.4.5-canary.20261119.1",
    "oxlint": "1.94.0",
    "supabase": "3.2.0",
    "turbo": "2.11.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "bun",
    "esbuild",
    "sharp",
    "supabase"
  ]
}
