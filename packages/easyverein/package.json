{
  "name": "@ml/easyverein",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "test": "bun test --randomize --isolate --path-ignore-patterns='**/*.integration.test.ts' src",
    "test:integration": "bun test --env-file=../../.env.local src/sync.integration.test.ts",
    "sync": "tsx --env-file-if-exists=../../.env.local src/cli.ts"
  },
  "dependencies": {
    "@ml/db": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ml/config": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
