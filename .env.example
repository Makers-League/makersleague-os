# `pnpm env:local` copies this to .env.local (repo root and apps/web) and fills in
# the keys of the running local Supabase stack. Real cloud values live in the
# password manager and in Netlify, never in git.

# App (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sync only (bypasses row level security). Never use it in pages or server actions.
SUPABASE_SECRET_KEY=

# easyVerein sync: fixtures (default, fake members) or api
EASYVEREIN_SOURCE=fixtures
# Only for EASYVEREIN_SOURCE=api. Not set up yet: needs a separate token for the OS.
EASYVEREIN_TOKEN=
SYNC_CLUB_SLUG=makers-league
# Shared secret between the scheduled and the background sync function on Netlify
SYNC_SECRET=local-sync-secret

# App emails (later). Auth emails use Lettermint via the Supabase SMTP settings.
LETTERMINT_PROJECT_TOKEN=
