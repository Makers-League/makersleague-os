{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"],
  "tasks": {
    "typegen": {
      "cache": false,
      "outputLogs": "errors-only"
    },
    "build": {
      "dependsOn": ["^build", "typegen"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "typegen"]
    },
    "test": {},
    "//#lint": {
      "dependsOn": ["@ml/web#typegen"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
