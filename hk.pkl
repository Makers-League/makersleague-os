amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

// Git hooks (install once with `hk install`). Pre-commit formats and lints the staged files;
// pre-push runs the same checks as CI's checks job, except the production build (CI only).
local code = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.mts")

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["format"] {
        glob = List("**/*.{ts,tsx,js,mjs,mts,json,md,yml,yaml,css,html}")
        check = "bun fmt --check {{ files }}"
        fix = "bun fmt {{ files }}"
      }
      ["lint"] {
        glob = code
        check = "bunx oxlint {{ files }}"
        fix = "bunx oxlint --fix {{ files }}"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["check"] {
        check = "bun run check"
      }
    }
  }
}
